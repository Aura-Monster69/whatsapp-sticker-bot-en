# Sticker metadata
STICKER_PACK_NAME=dcss-stickers
STICKER_AUTHOR=dcss

# Group access control (comma-separated).
# If both are empty, the bot responds to "!id" in any group so you can get the JID.
ALLOWED_GROUP_JIDS=
ALLOWED_GROUP_NAMES=

# Optional: allowed individual user numbers (e.g. 1234567890@s.whatsapp.net)
ALLOWED_USER_JIDS=

# Target maximum sticker duration (default: 6 seconds).
# Short videos (<= 6s) play at normal speed (1.0x).
# Longer/bigger videos (> 6s) are dynamically sped up so 100% of the video is captured.
MAX_VIDEO_SECONDS=6

# Optional base speed multiplier (default: 1.0 for natural speed).
VIDEO_SPEED=1.0

# Path to yt-dlp binary (defaults to yt-dlp in PATH)
YTDLP_PATH=yt-dlp

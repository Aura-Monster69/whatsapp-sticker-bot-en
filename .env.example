# Metadatos del sticker
STICKER_PACK_NAME=dcss-stickers
STICKER_AUTHOR=dcss

# Control de acceso por grupo (separados por coma).
# Si ambos están vacíos, el bot responde a "!id" en cualquier grupo para que obtengas el JID.
ALLOWED_GROUP_JIDS=
ALLOWED_GROUP_NAMES=

# Opcional: números individuales permitidos (ej. 573001234567@s.whatsapp.net)
ALLOWED_USER_JIDS=

# Duración máxima (en segundos) para stickers animados
MAX_VIDEO_SECONDS=8

# Ruta al binario yt-dlp (si no está en PATH, se intenta ~/.local/bin/yt-dlp)
YTDLP_PATH=yt-dlp
